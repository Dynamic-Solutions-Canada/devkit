{
  "name": "@dynamic-solutions-canada/devkit",
  "version": "0.18.1",
  "description": "Shared local dev infrastructure: a *.localhost hostname, an isolated database and derived ports for every checkout and worktree on the machine",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dynamic-Solutions-Canada/devkit.git"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "bin": {
    "devkit": "bin/devkit.mjs",
    "devproxy": "bin/devproxy.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./identity": "./src/checkout-identity.mjs"
  },
  "files": [
    "bin",
    "src",
    "infra",
    "vscode-extension",
    "README.md"
  ],
  "scripts": {
    "build:browser-extension": "node scripts/build-browser-extension.mjs",
    "check:browser-extension": "node scripts/check-browser-extension.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "validate": "npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
